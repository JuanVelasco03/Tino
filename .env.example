# Copia este archivo a .env.local y completa los valores.
# Ambas variables son públicas por diseño: la clave publicable está pensada
# para el navegador y la protegen las políticas a nivel de fila (RN-12).
#
# NUNCA agregues aquí la clave service_role ni ningún secreto con prefijo
# NEXT_PUBLIC_ (REGLAS §4).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOLO PRUEBAS. Va en .env.test.local (no en .env.local), sin prefijo público.
# La usa únicamente tests/aislamiento.test.ts para crear y borrar usuarios con
# la Admin API. Nunca la lee código de src/ ni atiende peticiones (REGLAS §4).
# Apunta solo a Tino dev, nunca a datos reales. Sin ella la prueba se omite.
# SUPABASE_SECRET_KEY=
